{
  "name": "velma-browser-streaming-example",
  "version": "0.1.0",
  "description": "Live transcript and synthetic voice detection in the browser, using Velma streaming through a small relay",
  "license": "MIT",
  "private": true,
  "type": "commonjs",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node server.js",
    "test": "node --test test/relay.test.js",
    "test:live": "node --test test/live.test.js",
    "test:failures": "node --test test/failures.test.js",
    "test:failures:live": "FAILURE_LIVE=1 node --test test/failures.test.js",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0"
  }
}
